# Safe template only. Copy or export values in your shell; never commit .env or OAuth files.
# M1 reads process environment variables only; this file is not auto-loaded.
# To override the local database directory, export PJF_DATA_DIR in your shell.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Asia/Jakarta

# Personal Google Sheets settings: keep real values in local .env only.
GOOGLE_SHEETS_SPREADSHEET_ID=replace_with_your_spreadsheet_id
GOOGLE_OAUTH_CLIENT_FILE=credentials/google-oauth-client.json
GOOGLE_OAUTH_TOKEN_FILE=data/credentials/google-token.json

# Gmail intake is deferred from the MVP (ADR-017).
# Do not add Gmail scopes or endpoints without a new approved ADR.
