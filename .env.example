# Safe template only. Copy or export values in your shell; never commit .env or OAuth files.
# M1 reads process environment variables only; this file is not auto-loaded.
# To override the local database directory, export PJF_DATA_DIR in your shell.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Asia/Jakarta

# Personal Google Sheets settings: keep real values in local .env only.
# The placeholder below is rejected on purpose; set the real spreadsheet ID locally.
GOOGLE_SHEETS_SPREADSHEET_ID=replace_with_your_spreadsheet_id

# Credential files default to <data-dir>/credentials/ and are never committed.
# Only set these to override the location, and prefer an absolute path outside
# this repository, for example:
#   GOOGLE_OAUTH_CLIENT_FILE=$HOME/.local/share/personal-job-finder/credentials/google-oauth-client.json
#   GOOGLE_TOKEN_FILE=$HOME/.local/share/personal-job-finder/credentials/google-token.json
GOOGLE_SHEETS_TIMEOUT_SECONDS=10
GOOGLE_SHEETS_MAX_BATCH_RANGES=100
GOOGLE_OAUTH_TIMEOUT_SECONDS=300
GOOGLE_KEYRING_SERVICE_NAME=personal-job-finder

# Never place OAuth client secrets, refresh tokens, or access tokens in this file.

# Gmail intake is deferred from the MVP (ADR-017).
# Do not add Gmail scopes or endpoints without a new approved ADR.
