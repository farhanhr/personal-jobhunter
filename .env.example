# Copy this file to .env (never commit .env) and fill in only what you need.
# The Google Service Account JSON key is NOT configured here. Place it at:
#   .local/credentials/google-service-account.json
# (relative to the repository root). Then use Settings -> Google Sheets, or run
#   job-hunter setup

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Asia/Jakarta

# The full Google Spreadsheet URL. Share the spreadsheet with the Service Account
# email as Editor before running setup.
# This is the only input a CLI-only user needs: set it here, then run
# `job-hunter setup` with no --spreadsheet-url. The app reads this file and never
# rewrites it. A Settings or --spreadsheet-url value wins over this file.
GOOGLE_SHEETS_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/replace_with_your_spreadsheet_id/edit

# Optional: the bare spreadsheet ID, used only when GOOGLE_SHEETS_SPREADSHEET_URL is unset.
# GOOGLE_SHEETS_SPREADSHEET_ID=replace_with_your_spreadsheet_id

# Precedence: a spreadsheet saved by Settings or the CLI wins over these .env values.
# If setup ran from this file, changing the value here takes effect and requires
# running setup again before the workspace counts as ready.
# The Service Account key is never stored here; install it with
# `job-hunter setup --key-file PATH` or the Settings upload.

GOOGLE_SHEETS_TIMEOUT_SECONDS=10
GOOGLE_SHEETS_MAX_BATCH_RANGES=100
GOOGLE_SHEETS_BATCH_SIZE=25
